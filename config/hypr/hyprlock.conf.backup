general {
    hide_cursor = true
    grace = 5
}

background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 8
}

input-field {
    monitor =
    size = 200, 50
    outline_thickness = 2
    dots_size = 0.33
    dots_spacing = 0.15
    outer_color = rgba(33ccffee)
    inner_color = rgba(1a1a1acc)
    font_color = rgba(e6e6e6ff)
    fade_on_empty = true
    placeholder_text = <i>password...</i>
    hide_input = false
    position = 0, -20
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME
    font_size = 64
    font_family = monospace
    color = rgba(e6e6e6ff)
    position = 0, 80
    halign = center
    valign = center
}
