{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/Pictures/screenshot-20261026-130946.png",
    "type": "kitty-direct",
    "width": 20,
    "color": {
      "1": "white"
    },
    "padding": {
      "top": 1,
      "left": 0
    }
  },
  "display": {
    "separator": " :: ",
    "color": {
      "keys": "white"
    }
  },
  "general": {
    "thread": true
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "break",
    {
      "type": "wm",
      "format": "{pretty-name} {version}"
    },
    "terminal",
    "break",
    {
      "type": "command",
      "key": "CPU",
      "text": "m=$(awk -F': ' '/model name/{print $2;exit}' /proc/cpuinfo | sed 's/ CPU//;s/ @.*//;s/(R)//g'); f=$(awk '{printf \"%g\", $1/1000000}' /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq); echo \"$m ($(nproc))@${f}GHz\""
    },
    "memory",
    {
      "type": "disk",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "battery",
      "key": "Battery",
      "format": "{model-name}"
    },
    "locale",
    "break",
    "colors"
  ]
}
