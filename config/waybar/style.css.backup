* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
}

window#waybar {
    background: transparent;
}

#clock {
    background: rgba(15, 15, 20, 1.0);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 14px;
    padding: 8px 80px;
    margin: 3px 4px;
    font-size: 18px;
    font-weight: bold;
}

#network,
#battery {
    background: rgba(15, 15, 20, 1.0);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 14px;
    padding: 5px 13px;
    margin: 5px 4px;
}

#battery.charging {
    color: white;
    font-weight: bold;
}
