/* Floating pills only — bar itself transparent. Change @pill-bg to recolor all pills. */
@define-color pill-bg #222222;

* {
    font-family: "JetBrainsMono Nerd Font", "Adwaita Sans", sans-serif;
    font-size: 13px;
    color: #ffffff;
    border: none;
    outline: none;
    min-height: 0;
}

window#waybar {
    background: transparent;
    border: none;
    box-shadow: none;
}

/* ---------- Left pills ---------- */
#workspaces {
    background: @pill-bg;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9px;
    padding: 3px 8px;
    margin: 4px 0 4px 4px;
}

#workspaces button {
    color: #555555;
    padding: 0 5px;
    font-size: 11px;
    background: transparent;
    border: none;
    box-shadow: none;
}

#workspaces button.active {
    color: #ffffff;
    background: rgba(137, 180, 250, 0.3);
    border: 1px solid rgba(137, 180, 250, 0.6);
    border-radius: 6px;
    box-shadow: 0 0 8px rgba(137, 180, 250, 0.8);
    text-shadow: 0 0 6px rgba(137, 180, 250, 1);
}

#workspaces button.urgent {
    color: #f38ba8;
}

#workspaces button:hover {
    color: #ffffff;
    background: transparent;
    border: none;
    box-shadow: none;
}

#wireplumber,
#custom-storage,
#custom-keys {
    background: @pill-bg;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9px;
    padding: 3px 12px;
    margin: 4px 0 4px 4px;
    font-weight: bold;
}

#wireplumber {
    color: #cba6f7;
}

#wireplumber.muted {
    color: #f38ba8;
    border-color: rgba(243, 139, 168, 0.4);
}

#custom-storage {
    color: #94e2d5;
}

#custom-keys {
    color: #f9e2af;
}

/* ---------- Center clock pill ---------- */
#clock {
    background: @pill-bg;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9px;
    padding: 3px 20px;
    margin: 4px 0;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
}

/* ---------- Right pills ---------- */
#custom-cpu,
#network,
#custom-battery {
    background: @pill-bg;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9px;
    padding: 3px 12px;
    margin: 4px 0;
    font-weight: bold;
}

#custom-cpu {
    color: #89b4fa;
}

#custom-cpu.warning {
    color: #f9e2af;
}

#custom-cpu.critical {
    color: #f38ba8;
    border-color: rgba(243, 139, 168, 0.5);
}

#network {
    color: #a6e3a1;
}

#network.disconnected {
    color: #f38ba8;
    border-color: rgba(243, 139, 168, 0.4);
}

#custom-battery.warning {
    color: #f9e2af;
}

#custom-battery.critical {
    color: #f38ba8;
    border-color: rgba(243, 139, 168, 0.5);
    animation-name: blink;
    animation-duration: 1s;
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

#custom-battery.charging, #custom-battery.plugged {
    color: #a6e3a1;
    border-color: rgba(166, 227, 161, 0.35);
}

@keyframes blink {
    to {
        background-color: rgba(243, 139, 168, 0.2);
    }
}

tooltip {
    background: @pill-bg;
    border: 1px solid rgba(137, 180, 250, 0.4);
    border-radius: 9px;
    padding: 8px;
}

tooltip label {
    color: #ffffff;
    /* smaller font = wider lines fit before GTK's ~585px tooltip clamp wraps them */
    font-size: 11px;
}
