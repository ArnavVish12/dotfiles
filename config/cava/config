# cava — terminal audio visualizer, follows whatever is playing
# Run with:  cava
# NOTE: gradient is fixed cool-blue; wallpaper-to-cava sync disabled in hypr/wallpaper-restore.sh

[general]
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_spacing = 1

[input]
method = pipewire
source = auto

[output]
channels = mono
mono_option = average
reverse = 0
orientation = bottom

[color]
background = default
foreground = default

# fixed cool-blue gradient (wallpaper sync removed — edit by hand now)
# monotonic luminance: deep navy -> icy near-white, no hue jumps
gradient = 1
gradient_count = 8
gradient_color_1 = '#0b1020'
gradient_color_2 = '#12203f'
gradient_color_3 = '#1a3a6b'
gradient_color_4 = '#2456a0'
gradient_color_5 = '#3a72c8'
gradient_color_6 = '#6a9be6'
gradient_color_7 = '#9dc0f2'
gradient_color_8 = '#e8f1ff'

[smoothing]
monstercat = 1
waves = 1
noise_reduction = 77
